DB_NAME=a6_stern
DB_USER=postgres
DB_PASSWORD=

MINIO_ENDPOINT=192.168.50.200
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
# Required when the app is accessed over the internet (Cloudflare Tunnel, reverse proxy, etc.).
# Without this, browsers block image/file requests because the internal MinIO IP is unreachable.
#
# Option A — proxy through the backend (no second tunnel needed):
#   MINIO_PUBLIC_URL=https://sitescope.smart-crg.com/api/media
#
# Option B — expose MinIO directly via a second Cloudflare Tunnel:
#   MINIO_PUBLIC_URL=https://minio.sitescope.smart-crg.com
MINIO_PUBLIC_URL=

HYPERBOLIC_API_KEY=
LEGACY_FRONTEND_PUBLIC_DIR=/legacy-frontend-public
DEBUG=false

# Email / SMTP — required for password reset and email verification
# Leave SMTP_HOST empty to disable email sending (auth flows still work without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=A6 Stern
SMTP_USE_TLS=true
